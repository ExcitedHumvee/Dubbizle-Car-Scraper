{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for Dubbizle Car Scraper",
  "main": "index.js",
  "scripts": {
    "scrape": "prisma generate && prisma migrate dev && node scraper/scraper.js && node scraper/save-to-db.js && npx prisma db execute --file reclaim-db-space.sql  && node export-cars-from-db.js && node update-index-html-with-new-cars.js",
    "scrape:count": "node scraper/scraper.js --dry-run",
    "scrape:test": "node scraper/test.js",
    "scrape:repair": "node scraper/repair-scrape.js",
    "test:scrape": "node scraper/test.js --offline",
    "test:db": "node scraper/test-save-to-db.js",
    "test:db-diff": "node scraper/diag/differential-save.js",
    "db:save": "node scraper/save-to-db.js && npx prisma db execute --file reclaim-db-space.sql",
    "db:reclaim": "npx prisma db execute --file reclaim-db-space.sql",
    "db:compact": "node scraper/compact-db.js",
    "db:compact:apply": "node scraper/compact-db.js --apply",
    "db:purge": "node scraper/purge-stale.js",
    "db:size": "node scraper/diag/db-size-audit.js",
    "db:restore": "node scraper/restore-processed.js",
    "db:restore:apply": "node scraper/restore-processed.js --apply",
    "db:seed": "node scraper/restore-processed.js --apply && node scraper/save-to-db.js && npx prisma db execute --file reclaim-db-space.sql",
    "db:setup": "prisma generate && prisma migrate deploy",
    "studio": "npx prisma studio",
    "export:all": "node export-cars-from-db.js",
    "sync:index": "node update-index-html-with-new-cars.js",
    "migrate:template": "node Scraper/migrate-template.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "5.15.0",
    "axios": "^1.12.2",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^5.1.0",
    "playwright": "^1.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "prisma": "5.15.0"
  },
  "type": "commonjs"
}
